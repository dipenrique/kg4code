      "args": ["install", "--dry-run", "${workspaceFolder}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Knowledge graphs: doctor",
      "detail": "kg-setup doctor: verify hooks, MCP, ignores and graph freshness",
      "type": "process",
      "command": "${userHome}/.local/bin/kg-setup",
      "args": ["doctor", "${workspaceFolder}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
